# Sprint 0 — Docker replication stack environment contract.
# Copy to .env (gitignored) before `docker compose up -d`:
#   Copy-Item .env.example .env
# Secrets are env-only: POSTGRES_PASSWORD / REPLICATION_PASSWORD have NO
# defaults in docker-compose.yml (:? fails fast). Dev placeholders below.

# Primary database (db_primary)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=edge_iam

# Streaming replication (db_replica connects as this role)
REPLICATION_USER=repl
REPLICATION_PASSWORD=change-me-dev-repl

# Host port bindings (dev only — override on collision)
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
